# Server configuration for the MySQL test container, replacing the one
# Testcontainers mounts. Replacement rather than override is required: that file
# sets innodb_log_file_size, removed in MySQL 9, and the server aborts on it.
# It is also the historic my-small.cnf -- a 16 MB buffer pool and a
# table_open_cache of 4, sized for a machine with under 64 MB of RAM.

[mysqld]

# --- InnoDB sizes itself -------------------------------------------------
#
# container_aware reads the container's cgroup limits instead of the host's;
# innodb_dedicated_server then takes 75 % of that for the buffer pool and
# derives the redo capacity from the CPU count. Both depend on the provider
# setting a hard memory limit on the container.
#
# Do not name innodb_buffer_pool_size or innodb_redo_log_capacity below:
# innodb_dedicated_server yields to any value set explicitly, so spelling one
# out switches the automatic sizing off.
container_aware = ON
innodb_dedicated_server = ON

# --- What the automatic sizing does not cover ----------------------------
table_open_cache = 2000
max_connections = 300
max_allowed_packet = 256M
sort_buffer_size = 4M
read_buffer_size = 4M
skip-name-resolve

# --- The container is discarded when the run ends ------------------------
#
# Wrong on a server whose data outlives the process: a torn write costs
# nothing here, no replica reads the binary log, and no transaction is worth
# an fsync.
innodb_flush_log_at_trx_commit = 2
innodb_doublewrite = 0
skip-log-bin
