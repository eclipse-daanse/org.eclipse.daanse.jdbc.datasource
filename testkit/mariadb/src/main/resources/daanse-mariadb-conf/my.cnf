# Server configuration for the MariaDB test container, replacing the one
# Testcontainers mounts -- the historic my-small.cnf, with a 16 MB buffer pool
# and a table_open_cache of 4, sized for a machine with under 64 MB of RAM.
# Replacing rather than overriding also keeps this working across versions: the
# same shipped file already stops MySQL 9 from starting at all.

[mariadb]

# --- Cache ---------------------------------------------------------------
#
# MariaDB has no innodb_dedicated_server, so the buffer pool is stated here:
# 62.5 % of MariaDbDatabaseProvider.MEMORY_LIMIT, within the 60-70 % MariaDB
# recommends for an InnoDB-only server. The remainder of the limit still has to
# hold connection buffers, temporary tables, the table caches, thread stacks and
# the performance schema. Keep the two in step.
innodb_buffer_pool_size = 2560M

# Equals the current default; stated because this file replaces one that set 4.
table_open_cache = 2000

# Costs more in invalidation than it returns on a workload that writes 250 MB
# and then reads it back from many threads.
query_cache_type = 0
query_cache_size = 0

open_files_limit = 65535
max_allowed_packet = 256M

# A ceiling, not an allocation -- the connection pool governs how many are
# actually opened.
max_connections = 300

# --- Bulk load -----------------------------------------------------------
innodb_log_file_size = 1G

# --- The container is discarded when the run ends ------------------------
#
# MariaDB's own guidance is innodb_flush_log_at_trx_commit=1 and sync_binlog=1,
# right for a server whose data outlives the process. Here a torn write costs
# nothing, no replica reads the binary log, and no transaction is worth an
# fsync.
innodb_flush_log_at_trx_commit = 2
innodb_doublewrite = 0
skip-log-bin

# Deliberately unset:
#   innodb_flush_method  - deprecated since MariaDB 11.0
#   sort_buffer_size, read_buffer_size, join_buffer_size - per connection;
#       inflating them globally costs memory on every thread
#   innodb_io_capacity   - has to come from the drive's sustained IOPS
#   thread_handling=pool-of-threads - worth testing only at hundreds of
#       connections
